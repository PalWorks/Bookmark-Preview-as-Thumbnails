{
    "manifest_version": 3,
    "name": "Visual Bookmark Manager with Thumbnail Previews",
    "version": "1.1.0",
    "description": "Capture, browse and manage bookmarks as visual thumbnail previews. Grid & list views, smart search, dark mode, and offline backup.",
    "author": "PalWorks",
    "permissions": [
        "storage",
        "tabs",
        "activeTab",
        "bookmarks",
        "scripting",
        "unlimitedStorage",
        "webNavigation"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "incognito": "split",
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "background": {
        "service_worker": "sw.js",
        "type": "module"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}