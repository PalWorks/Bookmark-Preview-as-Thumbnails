# SPDX-License-Identifier: AGPL-3.0-only
title: Bookmarks Thumbnails Architecture
direction: right

classes: {
  browser_component: {
    style: {
      stroke-dash: 3
      fill: "#f0f8ff"
    }
  }
}

User: {
  shape: person
}

Browser: {
  style: {
    fill: "#e6e6fa"
  }
  
  Extension: {
    class: browser_component
    
    Manifest: {
      shape: page
      tooltip: "manifest.json"
    }
    
    ServiceWorker: {
      shape: rectangle
      tooltip: "sw.ts: message router, capture pool, AI batches, update migration"
    }

    TrashCoordinator: {
      label: "Trash coordinator (sw/trash.ts)"
      shape: rectangle
      tooltip: "Single writer of trash_* keys; promise queue; reconcile on start; resumable restore"
    }

    ContentScript: {
      shape: rectangle
      tooltip: "Capture helper injected into capture tabs"
    }

    Popup: {
      label: "Extension page (React)"
      shape: square
      tooltip: "index.html: hooks (useTrash, useBookmarkTree, useThumbnails, useToast) and components"
    }

    Storage: {
      shape: cylinder
      tooltip: "storage.local: thumb_, meta_, trash_*, ai_*; storage.sync: settings; IndexedDB: legacy previews"
    }

    ChromeBookmarks: {
      label: "chrome.bookmarks"
      shape: cylinder
    }

    PurgeAlarm: {
      label: "alarm trash-purge (daily)"
      shape: oval
    }

    Manifest -> ServiceWorker: Defines
    Manifest -> ContentScript: Defines
    Manifest -> Popup: Defines

    Popup -> ServiceWorker: "Messages (BATCH_CAPTURE, META_PATCH, AUTO_TAG)"
    Popup -> TrashCoordinator: "TRASH_DELETE / RESTORE / EMPTY / PURGE"
    TrashCoordinator -> Popup: "TRASH_CHANGED broadcast"
    ServiceWorker -> TrashCoordinator: Routes
    ContentScript -> ServiceWorker: Messages
    ServiceWorker -> Storage: Reads/Writes
    TrashCoordinator -> Storage: "Snapshots, progress, asset sweep"
    TrashCoordinator -> ChromeBookmarks: "remove / removeTree / create"
    ChromeBookmarks -> Popup: "Bookmark events (reactive tree)"
    Popup -> Storage: "Reads (getKeys + targeted get)"
    PurgeAlarm -> TrashCoordinator: Expire after 30 days
  }

  Website: {
    class: browser_component
    tooltip: "Landing Page / Docs"
    
    Frontend: {
      shape: square
      tooltip: "React App"
    }
  }
}

User -> Browser.Extension.Popup: Interacts
User -> Browser.Website: Visits
Browser.Extension.Popup -> Browser.Website: Links to (Help/Support)

Deployment: {
  style: {
    fill: "#fff0f5"
    stroke: "#333"
  }

  GitHub: {
    shape: package
    tooltip: "Source Code & CI/CD"
    
    Repository: {
      shape: cylinder
    }
    
    Actions: {
      shape: callout
      type: "CI/CD"
      tooltip: ".github/workflows/deploy.yml"
    }
    
    Repository -> Actions: Push to main
  }

  BuildEnv: {
    label: "Build Environment (Ubuntu)"
    shape: rectangle
    style: {
      stroke-dash: 3
    }
    
    BuildWebsite: {
      shape: package
      label: "npm run build (Website)"
    }
    
    BuildExtension: {
      shape: package
      label: "npm run build (Extension)"
    }
  }

  Hosting: {
    GitHubPages: {
      shape: cloud
      tooltip: "Website Hosting"
    }
    
    ChromeWebStore: {
      shape: cloud
      tooltip: "Extension Distribution"
    }
  }

  GitHub.Actions -> BuildEnv.BuildWebsite: Triggers
  BuildEnv.BuildWebsite -> Hosting.GitHubPages: Deploys
  
  GitHub.Actions -> BuildEnv.BuildExtension: "CI: lint, test, build, bundle check"
  User -> BuildEnv.BuildExtension: "Release: npm run zip"
  BuildEnv.BuildExtension -> Hosting.ChromeWebStore: Upload Zip
}
